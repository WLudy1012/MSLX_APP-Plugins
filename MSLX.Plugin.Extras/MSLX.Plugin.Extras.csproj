<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 程序集名描述实际功能；插件 ID 由 IPlugin.Id 声明，与 DLL 文件名是不同概念。 -->
    <AssemblyName>MSLX.Plugin.AndroidThirdpartyAddons</AssemblyName>
    <RootNamespace>MSLX.Plugin.AndroidThirdpartyAddons</RootNamespace>
    <Product>MSLX Android 扩展插件</Product>
    <Description>为 MSLX Android 提供统一服务端扩展能力的第三方插件，当前包含扫码配对、设备授权管理和服务端图标。</Description>
    <Version>1.1.3</Version>
    <IsPackable>false</IsPackable>
    <!-- 生成内嵌文件清单：Daemon 面板用 ManifestEmbeddedFileProvider(assembly, "Frontend/dist") 下发插件前端 -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <PropertyGroup>
    <!-- MSLX.SDK 引用：按以下顺序自动探测（均不存在时报错，可用 -p:MSLX_SDK_DIR=... 覆盖）：
         1) 本仓库根下的 MSLX-dev/MSLX.SDK（CI 检出位置）；
         2) 与本仓库平级的 MSLX-dev/MSLX.SDK；
         3) 与本仓库平级的 MSLX-Android/MSLX-dev/MSLX.SDK（App 工作区布局）。 -->
    <MSLX_SDK_DIR Condition="'$(MSLX_SDK_DIR)' == '' AND Exists('$(MSBuildThisFileDirectory)../MSLX-dev/MSLX.SDK/MSLX.SDK.csproj')">$(MSBuildThisFileDirectory)../MSLX-dev/MSLX.SDK</MSLX_SDK_DIR>
    <MSLX_SDK_DIR Condition="'$(MSLX_SDK_DIR)' == '' AND Exists('$(MSBuildThisFileDirectory)../../MSLX-dev/MSLX.SDK/MSLX.SDK.csproj')">$(MSBuildThisFileDirectory)../../MSLX-dev/MSLX.SDK</MSLX_SDK_DIR>
    <MSLX_SDK_DIR Condition="'$(MSLX_SDK_DIR)' == '' AND Exists('$(MSBuildThisFileDirectory)../../MSLX-Android/MSLX-dev/MSLX.SDK/MSLX.SDK.csproj')">$(MSBuildThisFileDirectory)../../MSLX-Android/MSLX-dev/MSLX.SDK</MSLX_SDK_DIR>
    <MSLX_SDK_DIR Condition="'$(MSLX_SDK_DIR)' == ''">$(MSBuildThisFileDirectory)../../MSLX-dev/MSLX.SDK</MSLX_SDK_DIR>
    <MSLX_SDK_DIR>$([System.IO.Path]::GetFullPath('$(MSLX_SDK_DIR)'))</MSLX_SDK_DIR>
  </PropertyGroup>

  <Target Name="CheckSdkDir" BeforeTargets="ResolveProjectReferences">
    <Error Condition="!Exists('$(MSLX_SDK_DIR)/MSLX.SDK.csproj')"
           Text="未找到 MSLX.SDK 源码：$(MSLX_SDK_DIR)。请先检出 MSLTeam/MSLX（dev）并设置 -p:MSLX_SDK_DIR=...（或环境变量 MSLX_SDK_DIR）指向其 MSLX.SDK 目录，例如 -p:MSLX_SDK_DIR=D:\MSLX\MSLX.SDK。" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="$(MSLX_SDK_DIR)/MSLX.SDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 与 Daemon 主程序同版本：插件内 ALC 把依赖委托回主程序已加载的 Newtonsoft.Json -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- 提供 GenerateEmbeddedFilesManifest 构建目标（清单随程序集内嵌，运行时由 Daemon 侧读取） -->
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- 插件前端工程（源码 + 构建产物），除 dist 外不参与编译/输出 -->
    <Content Remove="Frontend/**" />
    <None Remove="Frontend/**" />
    <None Include="Frontend/**">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- 前端构建产物（Frontend/dist/mslx-plugin-entry.js 等）内嵌进 DLL，面板经 /plugins/{id}/{version}/ 动态加载 -->
    <EmbeddedResource Include="Frontend/dist/**/*" />
  </ItemGroup>

  <!-- 插件图标（硫磺史莱姆）源文件保留在 Assets/sulfur.png（隐式 None 项，无需配置）；
       运行期由 Frontend/dist/icon.png 经插件静态资源管线下发（Frontend\dist\** 已整体内嵌）。 -->

</Project>
